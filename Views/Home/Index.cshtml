@{
    ViewData["Title"] = "Inicio";
}

<style>
    :root {
        --primary: #2563eb;
        --secondary: #0f172a;
        --accent: #06b6d4;
        --soft: #f8fafc;
        --muted: #64748b;
        --card: #ffffff;
        --border: #e2e8f0;
    }

    .hero-mvc {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 16px;
        background:
            radial-gradient(circle at top left, rgba(37, 99, 235, 0.18), transparent 35%),
            radial-gradient(circle at bottom right, rgba(6, 182, 212, 0.18), transparent 35%),
            linear-gradient(135deg, #f8fafc 0%, #eef6ff 100%);
        border-radius: 24px;
        overflow: hidden;
    }

    .hero-card {
        width: min(1050px, 100%);
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(226, 232, 240, 0.9);
        border-radius: 28px;
        box-shadow: 0 28px 70px rgba(15, 23, 42, 0.12);
        backdrop-filter: blur(12px);
        padding: 44px;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 32px;
        align-items: center;
    }

    .badge-mvc {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        background: #dbeafe;
        color: #1d4ed8;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .hero-title {
        color: var(--secondary);
        font-size: clamp(34px, 5vw, 62px);
        line-height: 1;
        font-weight: 900;
        letter-spacing: -0.05em;
        margin-bottom: 18px;
    }

    .hero-title span {
        color: var(--primary);
    }

    .hero-description {
        color: var(--muted);
        font-size: 18px;
        line-height: 1.7;
        max-width: 640px;
        margin-bottom: 28px;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 26px;
    }

    .btn-main {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 46px;
        padding: 12px 20px;
        border-radius: 14px;
        background: var(--primary);
        color: #ffffff;
        text-decoration: none;
        font-weight: 800;
        box-shadow: 0 14px 30px rgba(37, 99, 235, 0.28);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-main:hover {
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 18px 36px rgba(37, 99, 235, 0.34);
    }

    .btn-secondary-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 12px 20px;
        border-radius: 14px;
        background: #ffffff;
        color: var(--secondary);
        border: 1px solid var(--border);
        text-decoration: none;
        font-weight: 800;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .btn-secondary-custom:hover {
        color: var(--secondary);
        border-color: var(--primary);
        transform: translateY(-2px);
    }

    .info-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .info-pill {
        padding: 10px 14px;
        border-radius: 14px;
        background: #f1f5f9;
        color: #334155;
        font-size: 13px;
        font-weight: 700;
    }

    .profile-panel {
        position: relative;
        background: linear-gradient(160deg, #0f172a, #1e3a8a);
        border-radius: 26px;
        padding: 28px;
        color: #ffffff;
        min-height: 360px;
        overflow: hidden;
        box-shadow: 0 24px 48px rgba(15, 23, 42, 0.25);
    }

    .profile-panel::before {
        content: "";
        position: absolute;
        width: 180px;
        height: 180px;
        right: -60px;
        top: -60px;
        background: rgba(6, 182, 212, 0.35);
        border-radius: 50%;
    }

    .profile-panel::after {
        content: "";
        position: absolute;
        width: 130px;
        height: 130px;
        left: -40px;
        bottom: -40px;
        background: rgba(37, 99, 235, 0.4);
        border-radius: 50%;
    }

    .profile-content {
        position: relative;
        z-index: 2;
    }

    .avatar-circle {
        width: 82px;
        height: 82px;
        border-radius: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.22);
        font-size: 38px;
        margin-bottom: 22px;
    }

    .profile-label {
        color: #93c5fd;
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: 8px;
    }

    .profile-name {
        font-size: 30px;
        font-weight: 900;
        line-height: 1.1;
        margin-bottom: 10px;
    }

    .profile-role {
        color: #cbd5e1;
        line-height: 1.6;
        margin-bottom: 24px;
    }

    .stats-mini {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .stat-box {
        padding: 14px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.16);
    }

    .stat-box strong {
        display: block;
        font-size: 22px;
        margin-bottom: 2px;
    }

    .stat-box span {
        font-size: 12px;
        color: #cbd5e1;
    }

    .features-section {
        margin-top: 26px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .feature-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 22px;
        box-shadow: 0 16px 36px rgba(15, 23, 42, 0.06);
    }

    .feature-icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #dbeafe;
        color: var(--primary);
        font-size: 22px;
        margin-bottom: 14px;
    }

    .feature-card h5 {
        color: var(--secondary);
        font-weight: 900;
        margin-bottom: 8px;
    }

    .feature-card p {
        color: var(--muted);
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
    }

    @@media (max-width: 900px) {
        .hero-grid {
            grid-template-columns: 1fr;
        }

        .features-section {
            grid-template-columns: 1fr;
        }

        .hero-card {
            padding: 28px;
        }
    }
</style>

<section class="hero-mvc">
    <div class="hero-card">
        <div class="hero-grid">
            <div>
                <div class="badge-mvc">
                    🚀 Proyecto MVC ASP.NET Core
                </div>

                <h1 class="hero-title">
                    Bienvenido a <span>DevOps</span>
                </h1>

                <p class="hero-description">
                    Sitio web desarrollado con ASP.NET Core MVC, aplicando estructura de vistas,
                    diseño responsivo y una presentación visual moderna para la página principal.
                </p>

                <div class="hero-actions">
                    <a class="btn-main" asp-controller="Home" asp-action="Privacy">
                        Ver información del proyecto
                    </a>

                    <a class="btn-secondary-custom" href="https://learn.microsoft.com/aspnet/core" target="_blank">
                        Documentación ASP.NET Core
                    </a>
                </div>

                <div class="info-row">
                    <div class="info-pill">✅ MVC</div>
                    <div class="info-pill">✅ Razor Views</div>
                    <div class="info-pill">✅ Diseño responsivo</div>
                    <div class="info-pill">✅ Bootstrap compatible</div>
                </div>
            </div>

            <div class="profile-panel">
                <div class="profile-content">
                    <div class="avatar-circle">👨‍💻</div>

                    <div class="profile-label">Desarrollado por</div>
                    <div class="profile-name">Elmer Leonel de la Cruz Fuentes</div>

                    <p class="profile-role">
                        Estudiante / Desarrollador del proyecto MVC con enfoque en diseño,
                        organización visual y buenas prácticas de presentación.
                    </p>

                    <div class="stats-mini">
                        <div class="stat-box">
                            <strong>ASP</strong>
                            <span>.NET Core MVC</span>
                        </div>

                        <div class="stat-box">
                            <strong>UI</strong>
                            <span>Diseño moderno</span>
                        </div>

                        <div class="stat-box">
                            <strong>HTML</strong>
                            <span>Razor + CSS</span>
                        </div>

                        <div class="stat-box">
                            <strong>2026</strong>
                            <span>Proyecto académico</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="features-section">
            <div class="feature-card">
                <div class="feature-icon">📌</div>
                <h5>Estructura MVC</h5>
                <p>
                    Separación clara entre controlador, vista y lógica de presentación,
                    manteniendo una base ordenada y fácil de ampliar.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">🎨</div>
                <h5>Diseño atractivo</h5>
                <p>
                    Página principal con tarjetas, colores modernos, sombreado suave y
                    distribución responsiva para diferentes pantallas.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">⚙️</div>
                <h5>ASP.NET Core</h5>
                <p>
                    Implementación sobre una plantilla MVC de ASP.NET Core, aprovechando
                    Razor, rutas y helpers propios del framework.
                </p>
            </div>
        </div>
    </div>
</section>
